{
  "name": "cafe-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:qr": "node scripts/generate-menu-qr.mjs",
    "build": "tsc -b && vite build",
    "build:vercel": "npm run build && node scripts/prepare-deploy.mjs",
    "preview": "vite preview",
    "test": "node --experimental-vm-modules --test api/floor.test.mjs api/floor-api.test.mjs api/waitlist.test.mjs && python3 -m unittest discover -s CRM/tests -v",
    "check": "npm run build && node --check CRM/dist/app.js && npm test"
  },
  "dependencies": {
    "@vercel/blob": "^2.6.1",
    "gsap": "^3.15.1",
    "lenis": "^1.3.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.65.1",
    "qrcode": "^1.5.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
